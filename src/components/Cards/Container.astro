---
interface Props {
	watchScroll?: boolean;
	class_?: string;
}

const {watchScroll, class_} = Astro.props;
---

<style>
	@media (prefers-reduced-motion: no-preference) {
		.scrollwatcher {
			animation: scrollwatcher linear;
			animation-timeline: scroll(y);
		}
		@keyframes scrollwatcher {
			from {
				scale: 0 1;
			}
		}
	}
</style>

<div
	class:list={["group relative rounded-box py-4", "transition duration-300 ease-in-out", class_]}
>
	<div class="relative mt-4 w-full font-headline font-bold">
		<div class="absolute top-1/2 h-0.5 w-[95%] bg-base-content/20"></div>
		<div
			class:list={[
				"transition-all duration-300 ease-in-out",
				"absolute top-1/2 h-0.5",
				"bg-gradient-to-r",
				{
					"scrollwatcher animate-scrollwatcher h-0.5 w-full origin-left from-base-200 via-base-300 to-base-content":
						watchScroll,
					"w-0 group-hover:w-full": !watchScroll,
				},
			]}
		>
		</div>
		<slot name="header" />
	</div>

	<slot name="body" />
</div>
