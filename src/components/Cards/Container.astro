---
interface Props {
	watchScroll?: boolean;
	class_?: string;
}

const {watchScroll, class_} = Astro.props;
---

<style>
	@media (prefers-reduced-motion: no-preference) {
		.scrollwatcher {
			animation: scrollwatcher linear;
			animation-timeline: scroll(y);
		}
		@keyframes scrollwatcher {
			from {
				scale: 0 1;
			}
		}
	}
</style>

<div
	class:list={[
		"rounded-box group relative py-4",
		"transition duration-300 ease-in-out",
		class_,
	]}
>
	<div class="font-headline relative w-full font-bold">
		<div class="bg-base-content/20 absolute top-1/2 h-0.5 w-[95%]"></div>
		<div
			class:list={[
				"transition-all duration-300 ease-in-out",
				"absolute top-1/2 h-0.5",
				"bg-gradient-to-r",
				{
					"scrollwatcher animate-scrollwatcher from-base-200 via-base-300 to-base-content h-0.5 w-full origin-left":
						watchScroll,
					"w-0 group-hover:w-full": !watchScroll,
				},
			]}
		>
		</div>
		<slot name="header" />
	</div>

	<slot name="body" />
</div>
