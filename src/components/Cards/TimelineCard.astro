---
import {parseDate} from "@/lib/utils";
import Link from "../Link.astro";
import type {Post} from "@keystatic/collections/posts";

interface Props {
	invert?: boolean;
	post: Post;
}

const {post, invert} = Astro.props;

const published = parseDate(new Date().toISOString());
---

<div class="group/tmc @container relative">
	<div
		class:list={[
			"flex flex-col items-center sm:flex-row sm:items-center",
			{
				"sm:flex-row-reverse": invert,
			},
		]}>
		<div
			class:list={[
				"rounded-btn p-4 font-bold",
				"text-lg @3xl:text-2xl @4xl:text-4xl",
				"border-base-300 group-hover/tmc:border-accent border-2",
				"duration-100 ease-in",
			]}>
			<span class="text-accent">{published?.date}</span>
			{published?.month}{" "}
			{published?.year}
		</div>

		<div
			class:list={[
				"mx-auto h-10 w-0.5 sm:h-0.5 sm:flex-1",
				"bg-base-300 group-hover/tmc:bg-accent",
				"duration-100 ease-in",
			]}>
		</div>

		<div
			class:list={[
				"flex h-full flex-col gap-3 p-3 @sm:flex-row",
				"group/tmcard rounded-box relative",
				"border-base-300 group-hover/tmc:border-accent border-2 select-none",
				"max-w-full @xl:max-w-md @2xl:max-w-lg @4xl:max-w-xl @4xl:min-w-96",
				"duration-100 ease-in",
			]}>
			<Link
				aria-label={`Read "${post.title}"`}
				transition:name="title"
				href={`/blog/${post.slug}`}
				class:list={["line-clamp-4 font-light"]}>
				<span class="prose-base font-title text-accent"> {post.title} </span>

				<div class="prose-sm @4xl:prose-base mt-2 text-pretty">
					<p class="line-clamp-5">{post.description}</p>
				</div>
			</Link>
		</div>
	</div>
</div>
