---
interface Props {
	text: string;
	coloredLines?: number[];
}

const {text = "TEXT MISSING", coloredLines = [1]} = Astro.props;
const lines = text.split(" ");
---

<div data-theme="dark" class="overlay absolute inset-0 w-full p-4">
	<h1
		class="flex flex-col items-center font-bold text-[#B7AB98]"
		style="font-size: 8rem; line-height: 6.5rem;"
	>
		{
			lines.map((line, li) => {
				const chars = line.split("");
				const colored = coloredLines.includes(li);
				return (
					<div class:list={["line", {"text-[#EB5939]": colored}]}>
						{chars.map((char) => {
							return <div class="char inline-block">{char}</div>;
						})}
					</div>
				);
			})
		}
	</h1>
</div>

<style>
	.overlay {
		clip-path: circle(100p at var(--x, 50%) var(--y, 50%));
		transition: clip-path 100ms;
	}
</style>

<script>
	import {gsap} from "gsap";
	const ov = document.querySelector(".overlay");
	window.addEventListener("mousemove", (e) => {
		const {clientX, clientY} = e;
		const x = Math.round((clientX / window.innerWidth) * 100);
		const y = Math.round((clientY / window.innerHeight) * 100);
		gsap.to(ov, {
			"--x": `${x}%`,
			"--y": `${y}%`,
			duration: 0.3,
			ease: "sine.out",
		});
	});
</script>
