---
interface Props {
	text: string;
	coloredLines?: number[];
}

const {text = "TEXT MISSING", coloredLines = [1]} = Astro.props;
const lines = text.split(" ");
---

<div data-theme="light" class="p-4">
	<h1
		class="flex flex-col items-center font-bold text-[#B7AB98]"
		style="font-size: 8rem; line-height: 6.5rem;"
	>
		{
			lines.map((line, li) => {
				const chars = line.split("");
				const colored = coloredLines.includes(li);
				return (
					<div class:list={["line", {"text-[#EB5939]": colored}]}>
						{chars.map((char) => {
							return <div class="char inline-block">{char}</div>;
						})}
					</div>
				);
			})
		}
	</h1>
</div>
