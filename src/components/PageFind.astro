---

<script is:inline data-astro-rerun src="/_pagefind/pagefind-ui.js"></script>
<link href="/_pagefind/pagefind-ui.css" rel="stylesheet" />

<div class:list={["mx-auto mt-4 h-full min-h-8 max-w-4xl px-12"]}>
	<div id="searchui" class:list={["relative min-h-12"]}></div>
</div>

<script is:inline data-astro-rerun>
	(function () {
		try {
			// @ts-nocheck
			new PagefindUI({
				element: "#searchui",
				resetStyles: false,
				debounceTimeoutMs: 50,
				showImages: true,
				showEmptyFilters: true,
			});
		} catch (_) {}
	})();
</script>
