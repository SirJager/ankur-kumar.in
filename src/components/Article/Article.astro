---
import Tags from "./Tags.astro";
import TableOfContent from "./TableOfContent.astro";
import type { Heading, Post } from "@/content";

interface Props {
	post: Post;
	headings: Heading[];
}

const {post, headings} = Astro.props;
---

<article role="article" data-pagefind-body class="relative space-y-8 px-4">
	<header
		class:list={[
			"relative mx-auto max-w-4xl bg-repeat",
			"fade-top-bottom bg-[url('/svg/grid-cell-light.svg')] dark:bg-[url('/svg/grid-cell-dark.svg')]",
		]}
	>
		<div class="flex h-full w-full flex-col justify-center py-8 md:px-12">
			<h1
				role="heading"
				data-weight="50"
				data-pagefind-meta="title"
				data-pagefind-sort="weight[data-weight]"
				transition:name={`article-${post.slug}`}
				class:list={["text-pretty text-6xl sm:text-7xl md:text-8xl", "font-headline font-bold"]}
			>
				{post.title}
			</h1>

			<p class="prose mt-4 font-X sm:prose-xl">
				{post.description}
			</p>
		</div>
	</header>

	<div
		class:list={[
			"relative grid grid-cols-[1fr,min(600px,100%),1fr] gap-2",
			"xl:grid-cols-[1fr,min(672px,100%),1fr]",
			"2xl:grid-cols-[1fr,minmax(auto,360px),min(672px,100%),minmax(auto,360px),1fr] 2xl:[&>*]:col-start-2",
		]}
	>
		<div class:list={["space-y-8"]}>
			<div class="font-heading sticky top-4 mt-10 hidden lg:block">
				<TableOfContent isOpened={true} headings={headings} />
			</div>
		</div>

		<div id="article-content" class:list={["py-6 2xl:!col-start-3", "prose sm:prose-xl"]}>
			<slot>content not found</slot>
		</div>
	</div>

	<div class="mx-auto mt-8 max-w-2xl">
		<Tags tags={post.tags} />
	</div>
</article>
