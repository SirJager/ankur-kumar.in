---
import Link from "@/components/Link.astro";
import {footerSection} from "./data";
import styles from "@/styles";
---

{
	footerSection.map((section) => {
		return (
			<div class="group relative col-span-1 overflow-clip p-4">
				<h3
					class:list={[
						"font-title block w-fit p-1 text-sm font-semibold uppercase tracking-widest",
						styles.underlinefx.main,
						"group-hover:after:w-full",
					]}
				>
					<span class={styles.underlinefx.span}>{section.name}</span>
				</h3>
				<ul class="mt-2 space-y-2">
					{section.items.map((item) => {
						return (
							<li class="group/link relative w-full">
								<Link
									id={item.id}
									href={item.url}
									aria-label={item.name}
									data-umami-event={item.event}
									target={item.target}
									class:list={[
										"rounded-btn relative block w-fit overflow-hidden p-1 px-2",
										styles.slidefx.main,
									]}
								>
									<span class={styles.slidefx.span}>{item.name}</span>
								</Link>
							</li>
						);
					})}
				</ul>
			</div>
		);
	})
}
