---
type Props = {
	copyright: string;
};

const currentYear = new Date().getFullYear();
const copyright = Astro.props.copyright;
---

<div id="footer-copyright" class="font-body space-x-1 p-2 text-lg">
	&copy; <span id="current-year">{currentYear}</span>
	<span class="font-title">{copyright}</span>
</div>

<script>
	const ele = document.getElementById("current-year");
	if (ele) {
		ele.innerHTML = `${new Date().getFullYear()}`;
	}
</script>
