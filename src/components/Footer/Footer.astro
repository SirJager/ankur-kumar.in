---
import NewsLetter from "../NewsLetter.astro";
import Copyright from "./Copyright.astro";
import LinksSection from "./LinksSection.astro";
import SocialIcons from "./SocialIcons.astro";
---

<div class="mb-20 mt-32 md:mb-0">
	<div
		class:list={[
			"@container mx-auto w-full max-w-7xl px-4",
			"border-base-300 border-t pt-12",
		]}>
		<div class:list={["@lg:grid-cols-3 @4xl:grid-cols-6 grid grid-cols-2 py-8"]}>
			<LinksSection />
			<NewsLetter />
		</div>
	</div>
</div>

<div
	class:list={[
		"@container mx-auto w-full max-w-7xl px-4 pb-10 pt-8",
		"flex flex-col items-center gap-4 sm:flex-row sm:justify-between",
	]}>
	<Copyright />
	<SocialIcons />
</div>
