---
import {Icon} from "astro-icon/components";
import Link from "@/components/Link.astro";
import {findEntry} from "@/dal";
import type {Footer} from "@keystatic/collections/footer";
import type {ReusableLink} from "@keystatic/collections/links";

const footer = await findEntry<Footer>("footer", "global");
const links: ReusableLink[] = [];
for (const link of footer.links ?? []) {
	const entry = await findEntry<ReusableLink>("links", link);
	links.push(entry);
}
---

<div class="flex w-fit items-center gap-8">
	{
		links.map((link) => {
			if (!link.icon) return null;
			return (
				<Link
					title={link.label}
					aria-label={link.label}
					href={link.href}
					data-umami-event={link.label}
					class="grayscale hover:grayscale-0">
					<Icon size={26} name={link.icon} style={{color: link.color}} />
				</Link>
			);
		})
	}
</div>
