---

---

<div
	data-tip="Newsletter is coming soon"
	class="tooltip col-span-2 mt-20 grid place-items-center text-left @lg:col-span-3 @4xl:mt-0">
	<div
		class:list={[
			"rounded-box pointer-events-none h-fit w-full p-4 @lg:p-8",
			"border-base-300 border",
		]}>
		<div class="flex items-center gap-2">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				stroke-width="1.5"
				fill="none"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="stroke-base-content inline h-5 w-5">
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
				<path d="M10 21v-6.5a3.5 3.5 0 0 0 -7 0v6.5h18v-6a4 4 0 0 0 -4 -4h-10.5"></path>
				<path d="M12 11v-8h4l2 2l-2 2h-4"></path>
				<path d="M6 15h1"></path>
			</svg>
			<p class="font-title font-semibold">Stay up to date</p>
		</div>

		<p class="text-neutral-content mt-2 text-sm">
			Get notified when I publish something new and unsubscribe at any time
		</p>

		<div
			class="rounded-btn border-base-200 hover:border-accent mt-4 flex items-center border-2 p-1">
			<input
				type="email"
				placeholder="Email address"
				class="rounded-btn bg-base-100 placeholder:text-base-content/60 w-full border-none px-4 py-2 outline-none"
			/>
			<button
				class:list={[
					"btn btn-accent font-bold",
					"focus:ring-accent ring-offset-white outline-none focus:ring-2 focus:ring-offset-2 focus:outline-none dark:focus:ring-offset-black",
				]}>
				Subscribe
			</button>
		</div>
	</div>
</div>
