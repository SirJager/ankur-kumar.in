---
import type {Post} from "@keystatic/collections/posts";
import TimelineCard from "../Cards/TimelineCard.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
	posts: Post[];
}

const {posts} = Astro.props;
---

<section class="mx-auto mt-48 w-full max-w-5xl">
	<SectionHeading
		text="Recent"
		colored="Updates"
		description="Here are some of my latest updates"
	/>

	<div class="relative mx-auto space-y-20 p-4">
		{
			posts.map((post, index) => {
				const invert = index % 2 === 0;
				return <TimelineCard post={post} invert={invert} />;
			})
		}
	</div>
</section>
