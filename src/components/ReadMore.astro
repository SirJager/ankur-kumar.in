---
import {generateRandomID} from "@/lib/utils";
import styles from "@/styles";

interface Props {
	className?: string;
	id?: string;
	labelHide?: string;
	labelReadmore?: string;
	readmore?: string[];
}

const {id = generateRandomID(8), readmore = [], className} = Astro.props;
const {labelReadmore = "Read more", labelHide = "Hide"} = Astro.props;
---

<p class:list={["prose-sm sm:prose-lg leading-relaxed", className]}>
	<input id={id} type="checkbox" class="peer hidden" />

	<slot> add main text here </slot>

	{
		readmore.length > 0 && (
			<>
				<span class="hidden peer-checked:inline">
					{readmore.map((para, index) => {
						const last = readmore.length - 1 === index;
						return (
							<span>
								{index === 0 && <br />}
								{index === 0 && <br />}
								{para}
								{!last && <br />}
								{!last && <br />}
							</span>
						);
					})}
				</span>

				<label
					for={id}
					class:list={[
						"text-accent cursor-pointer font-bold peer-checked:hidden focus:outline-none",
						styles.underlinefx.main,
					]}>
					<span class={styles.underlinefx.span}>{labelReadmore}</span>
				</label>

				<label
					for={id}
					class:list={[
						"text-accent hidden cursor-pointer font-bold peer-checked:inline focus:outline-none",
						styles.underlinefx.main,
					]}>
					<span class={styles.underlinefx.span}>{labelHide}</span>
				</label>
			</>
		)
	}
</p>
