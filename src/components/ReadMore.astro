---
import {generateRandomID} from "@/lib/utils";

interface Props {
	id?: string;
	readmore?: string[];
	labelReadmore?: string;
	labelHide?: string;
	className?: string;
}

const {id = generateRandomID(8), readmore = [], className} = Astro.props;
const {labelReadmore = "Read more", labelHide = "Hide"} = Astro.props;
---

<p class:list={["font-base prose-sm leading-relaxed md:prose-lg", className]}>
	<input id={id} type="checkbox" class="peer hidden" />

	<slot> add main text here </slot>

	<span class="hidden peer-checked:inline">
		{
			readmore.map((para) => {
				return (
					<span>
						<br />
						<br />
						{para}
					</span>
				);
			})
		}
	</span>
	<label
		for={id}
		class="cursor-pointer text-primary underline focus:outline-none peer-checked:hidden"
		>{labelReadmore}</label
	>
	<label
		for={id}
		class="hidden cursor-pointer text-primary underline focus:outline-none peer-checked:inline"
		>{labelHide}</label
	>
</p>
