---
import Link from "@/components/Link.astro";
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher";
import type {ILink} from "@/dal/types";
import {navigationLinks} from "./data";

interface Props {
	links?: ILink[];
}

const {links = navigationLinks} = Astro.props;
---

<div>
	<div
		class:list={[
			"relative z-[9999] mx-auto w-full max-w-4xl px-4 py-5 md:px-12",
			"@container flex items-center justify-between gap-2",
		]}
	>
		<Logo />

		<div class="flex items-center gap-4">
			<nav class:list={["relative hidden items-center gap-2 md:flex"]}>
				{
					links.map((link) => {
						return (
							<Link
								aria-label={`Go to ${link.label}`}
								key={link.label}
								href={link.href}
								newtab={link.newtab}
								class:list={[
									"relative mx-3 overflow-clip p-1 px-2 font-bold tracking-wider",
									//
									"relative after:transition-all after:duration-100 after:ease-in-out",
									"after:absolute after:bottom-0 after:left-0 after:h-1/2 after:content-['']",
									"after:bg-base-300 after:w-0 hover:after:w-full",
								]}
							>
								<span class="relative z-[1]">{link.label}</span>
							</Link>
						);
					})
				}
			</nav>
			<ThemeSwitcher />
		</div>
	</div>
</div>
