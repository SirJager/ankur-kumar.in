---
import {getEntry} from "astro:content";
import Link from "@/components/Link.astro";
import Logo from "@/components/Logo.astro";
import type {INavbar} from "@/dal/types";

const main = await getEntry("navbar", "global");
if (!main) {
	throw new Error("Could not find navbar record");
}

const navbar: INavbar = main.data;
---

<div>
	<div
		class:list={[
			"z-9999 relative mx-auto w-full max-w-4xl px-4 py-5 md:px-12",
			"@container flex items-center justify-between gap-2",
		]}>
		<Logo />

		<div class="flex items-center gap-4">
			<nav class:list={["relative hidden items-center gap-2 md:flex"]}>
				{navbar.links.map((link) => {
						return (
							<Link
								key={link.label}
								href={link.href}
								newtab={link.newtab}
								aria-label={link.label}
								class:list={[
									"relative mx-3 overflow-clip p-1 px-2 font-bold tracking-wider",
									//
									"relative after:transition-all after:duration-100 after:ease-in-out",
									"after:absolute after:bottom-0 after:left-0 after:h-1/2 after:content-['']",
									"after:bg-base-300 after:w-0 hover:after:w-full",
								]}
				>
								<span class="z-1 relative">{link.text}</span>
							</Link>
						);
					})}
			</nav>
			<!-- <ThemeSwitcher /> -->
		</div>
	</div>
</div>
