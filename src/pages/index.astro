---
import Link from "@/components/Link.astro";
import PageFind from "@/components/PageFind.astro";
import ReadMore from "@/components/ReadMore.astro";
import LatestUpdates from "@/components/Sections/LatestUpdates.astro";
import TechStack from "@/components/Sections/TechStack.astro";
import {findEntries, findEntry} from "@/dal";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {links} from "@/lib/constants";
import styles from "@/styles";
import type {Post} from "@keystatic/collections/posts";
import type {User} from "@keystatic/collections/users";

const posts = await findEntries<Post>("posts");
const ankur = await findEntry<User>("users", "ankur");
---

<BaseLayout title="Home">
	<header
		style="background: var(--grid-cell);"
		class:list={[
			"fade-top dark:fade-top-bottom relative mx-auto mt-20 max-w-4xl overflow-hidden bg-repeat px-4",
		]}>
		<div class="flex h-full w-full flex-col justify-center py-8 md:px-12">
			<h1
				data-weight="50"
				data-pagefind-meta="title"
				data-pagefind-sort="weight[data-weight]"
				aaria-role="heading"
				class:list={["font-title text-3xl font-medium text-pretty sm:text-5xl md:text-6xl"]}>
				{ankur.fullName}
			</h1>

			<ReadMore className="group mt-12">
				{ankur.about}
			</ReadMore>
			<p
				class:list={[
					"prose-sm mt-2 font-medium text-pretty",
					"sm:prose-lg prose-a:font-bold prose-a:text-accent",
				]}>
				Subscribe to the
				<Link aria-label="RSS" href={links.rss.href} class:list={styles.underlinefx.main}>
					<span class={styles.underlinefx.span}>RSS Feed</span>
				</Link> to stay updated.
			</p>
		</div>
	</header>

	<TechStack />
	<PageFind />
	<LatestUpdates posts={posts} />
</BaseLayout>
