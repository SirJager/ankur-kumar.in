---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TechStack from "@/components/Sections/TechStack.astro";
import PageFind from "@/components/PageFind.astro";
import LatestUpdates from "@/components/Sections/LatestUpdates.astro";
import {getMatters} from "@/dal/astro";
import {getCollection} from "astro:content";
import {authors, links} from "@/lib/constants";
import ReadMore from "@/components/ReadMore.astro";
import Link from "@/components/Link.astro";
import styles from "@/styles";

const posts = getMatters(await getCollection("blog"));
---

<BaseLayout title="Home">
	<header
		style="background: var(--grid-cell);"
		class:list={[
			"fade-top dark:fade-top-bottom relative mx-auto mt-20 max-w-4xl overflow-hidden bg-repeat px-4",
		]}
	>
		<div class="flex h-full w-full flex-col justify-center py-8 md:px-12">
			<h1
				role="heading"
				data-weight="50"
				data-pagefind-meta="title"
				data-pagefind-sort="weight[data-weight]"
				class:list={["font-title text-pretty text-3xl font-medium sm:text-5xl md:text-6xl"]}
			>
				{authors.ankur.fullName}
			</h1>

			<ReadMore className="group mt-12">
				A self-driven full-stack developer with a strong focus on developing high performance
				backend APIs and microservices using latest and greatest technologies.
			</ReadMore>
			<p
				class:list={[
					"prose-sm mt-2 text-pretty font-medium",
					"sm:prose-lg prose-a:font-bold prose-a:text-accent",
				]}
			>
				Subscribe to the <Link
					aria-label="RSS"
					href={links.rss.href}
					class:list={styles.underlinefx.main}
				>
					<span class={styles.underlinefx.span}>RSS Feed</span>
				</Link> to stay updated.
			</p>
		</div>
	</header>

	<TechStack />
	<PageFind />
	<LatestUpdates posts={posts} />
</BaseLayout>
