---
import BlogLayout from "@/layouts/Blog/BlogLayout.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostsGrid from "@/layouts/Blog/PostGrid.astro";

import {getMatters} from "@/dal/astro";
import {getCollection} from "astro:content";
import {site} from "@/lib/constants";

export async function getStaticPaths() {
	const posts = getMatters(await getCollection("blog"));
	const tags = await getCollection("tags");
	return tags.map((tag: any) => ({
		params: {tag: tag.id},
		props: {
			posts: posts.filter((post) => post.tags.includes(tag.id)),
		},
	}));
}
const {posts} = Astro.props;
---

<BaseLayout title="Blog" description={site.blog.metaDescription}>
	<BlogLayout>
		<div slot="body" class="mx-auto mt-20 w-full max-w-4xl px-12">
			<PostsGrid posts={posts} />
		</div>
	</BlogLayout>
</BaseLayout>
