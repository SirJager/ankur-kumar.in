---
import {getCollection} from "astro:content";
import {getMatters} from "@/dal/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogLayout from "@/layouts/Blog/BlogLayout.astro";
import PostsGrid from "@/layouts/Blog/PostCard.astro";

export async function getStaticPaths() {
	const posts = getMatters(await getCollection("posts"));
	const tags = await getCollection("tags");
	return tags.map((tag: any) => ({
		params: {tag: tag.id},
		props: {posts: posts.filter((post) => post.tags.includes(tag.id))},
	}));
}
const {posts} = Astro.props;
---

<BaseLayout title="Blog">
	<BlogLayout>
		<div slot="body" class="mx-auto mt-20 w-full max-w-4xl px-12">
			<!---->
			<PostsGrid posts={post} />
		</div>
	</BlogLayout>
</BaseLayout>
