---
import BlogLayout from "@/layouts/Blog/BlogLayout.astro";
import {getCollection} from "astro:content";
import {getMatters} from "@/dal/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
const posts = getMatters(await getCollection("blog"));
import PostsGrid from "@/layouts/Blog/PostGrid.astro";
---

<BaseLayout title="Blog">
	<BlogLayout>
		<div slot="body" class="mx-auto mt-20 w-full max-w-4xl px-4 md:px-12">
			<PostsGrid posts={posts} />
		</div>
	</BlogLayout>
</BaseLayout>
