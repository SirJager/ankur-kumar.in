---
import {getCollection} from "astro:content";
import {getMatters} from "@/dal/astro";

export async function getStaticPaths() {
	const posts = getMatters(await getCollection("blog"));
	const categories = await getCollection("categories");
	return categories.map((c) => ({
		params: {category: c.id},
		props: {posts: posts.filter((post) => post.categories.includes(c.id))},
	}));
}

const {posts} = Astro.props;
---

<BaseLayout title="Blog" description={site.blog.metaDescription}>
	<BlogLayout>
		<div slot="body" class="mx-auto mt-20 w-full max-w-4xl px-12"><PostsGrid posts={posts} /></div>
	</BlogLayout>
</BaseLayout>
