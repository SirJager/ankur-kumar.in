---
import {findEntry} from "@/dal";
import {links} from "@/lib/constants";
import type {Post} from "@keystatic/collections/posts";
import type {User} from "@keystatic/collections/users";

interface Props {
	post: Post;
}

const {post} = Astro.props;

const taxonomies = new Set<string>();
for (const tag of post.tags) {
	taxonomies.add(tag.toLowerCase());
}
for (const cat of post.categories) {
	taxonomies.add(cat.toLowerCase());
}

const ankur = await findEntry<User>("users", "ankur");

const ogimage = `${Astro.url.origin}/blog/${post.slug}/og.png`;
let schema: Record<string, unknown> = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	author: {
		"@type": "Person",
		image: ankur.avatar,
		name: ankur.fullName,
		url: links.website.href,
	},
	dateModified: post.updated.toISOString().substring(0, 10),
	/* the schema expects Date or DateTime using ISO 8601 format. For Date that is yyyy-MM-dd */
	datePublished: new Date().toISOString().substring(0, 10),
	description: post.description,
	genre: post.categories,
	headline: post.title,
	image: post.thumbnail ?? ogimage,
	keywords: Array.from(taxonomies),
	// wordcount: post.readtime?.words,
};
---

<script
	is:inline
	data-astro-rerun
	slot="head"
	type="application/ld+json"
	set:html={JSON.stringify(schema)}
/>
