---
import Link from "@/components/Link.astro";
import styles from "@/styles";
import {Icon} from "astro-icon/components";
interface Props {
	categories: string[];
}
const {categories} = Astro.props;
---

<div class="flex items-center gap-1">
	<Icon name="tabler:category-2" size={20} class="text-base-content/60" />
	<ul class="flex items-center gap-3">
		{
			categories.map((category) => {
				return (
					<li class="m-0 p-0">
						<Link
							href={`/categories/${category}`}
							aria-label={`View posts in "${category}"`}
							data-pagefind-filter="category"
							data-pagefind-meta="category"
							transition:name={`category-${category}`}
							class:list={[
								"group prose capitalize",
								styles.underlinefx.main,
								"after:-bottom-1 hover:text-base-content",
							]}
						>
							<span class={styles.underlinefx.span}>{category}</span>
						</Link>
					</li>
				);
			})
		}
	</ul>
</div>
