---
import {Icon} from "astro-icon/components";
import Link from "@/components/Link.astro";
import styles from "@/styles";

interface Props {
	categories: string[];
}
const {categories = []} = Astro.props;
---

{
	categories?.length > 0 && (
		<div class="group flex items-center gap-1">
			<Icon
				name="tabler:category-2"
				size={20}
				class="text-base-content/60 group-hover:text-accent"
			/>
			<ul class="flex items-center gap-3">
				{categories.map((category, i) => {
					return (
						<li class="m-0 p-0">
							<Link
								href={`/categories/${category}`}
								aria-label={`View posts in "${category}"`}
								data-pagefind-filter="category"
								data-pagefind-meta="category"
								transition:name={`category-${category}`}
								class:list={[
									"prose group capitalize",
									styles.underlinefx.main,
									"hover:text-base-content after:-bottom-1",
								]}>
								<span class={styles.underlinefx.span}>{category}</span>
								{i === categories.length - 1 ? <span /> : <span>,</span>}
							</Link>
						</li>
					);
				})}
			</ul>
		</div>
	)
}
