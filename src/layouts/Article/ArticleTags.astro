---
import Link from "@/components/Link.astro";
import styles from "@/styles";
import {Icon} from "astro-icon/components";
interface Props {
	tags: string[];
}
const {tags} = Astro.props;
---

<div class="flex items-center gap-1">
	<Icon name="tabler:tags" size={20} class="text-base-content/60" />
	<ul class="flex items-center gap-3">
		{
			tags.map((tag) => {
				return (
					<li class="m-0 p-0">
						<Link
							href={`/categories/${tag}`}
							aria-label={`View posts in "${tag}"`}
							data-pagefind-filter="category"
							data-pagefind-meta="category"
							transition:name={`category-${tag}`}
							class:list={[
								"group prose",
								styles.underlinefx.main,
								"after:-bottom-1 hover:text-base-content",
							]}
						>
							<span class={styles.underlinefx.span}>#{tag}</span>
						</Link>
					</li>
				);
			})
		}
	</ul>
</div>
