---
import ArticleTags from "./ArticleTags.astro";
import TableOfContent from "./TableOfContent.astro";
import type {Heading, Post} from "@/dal/schema";
import ArticleCategories from "./ArticleCategories.astro";
import ArticleDate from "./ArticleDate.astro";

interface Props {
	post: Post;
	headings: Heading[];
}

const {post, headings} = Astro.props;
---

<article role="article" data-pagefind-body class="relative space-y-8 px-4">
	<header
		class:list={[
			"fade-top-bottom mt-8 w-full max-w-4xl space-y-6 px-4 py-16 md:px-12",
			"group/header relative mx-auto bg-repeat",
			"bg-[url('/svg/grid-cell-light.svg')] dark:bg-[url('/svg/grid-cell-dark.svg')]",
		]}
	>
		<h1
			id="post-title"
			role="heading"
			data-weight="50"
			data-pagefind-meta="title"
			data-pagefind-sort="weight[data-weight]"
			transition:name={`article-${post.slug}`}
			class:list={[
				"font-title text-5xl font-bold sm:text-6xl lg:text-7xl",
				"transition-all duration-1000 ease-in-out",
				"text-pretty brightness-50 group-hover/header:brightness-110",
			]}
		>
			{post.title}
		</h1>

		<p class="prose">
			{post.description}
		</p>

		<div class="flex items-center gap-3">
			<ArticleDate date={post.publish} />
			<ArticleCategories categories={post.categories} />
			<ArticleTags tags={post.tags} />
		</div>
	</header>

	<div
		class:list={[
			"relative grid grid-cols-[1fr,min(600px,100%),1fr] @container sm:gap-4",
			"lg:grid-cols-[1fr,min(580px,100%),1fr]",
			"xl:grid-cols-[1fr,min(672px,100%),1fr]",
			"2xl:grid-cols-[1fr,minmax(auto,360px),min(672px,100%),minmax(auto,360px),1fr] 2xl:[&>*]:col-start-2",
		]}
	>
		<div class:list={["space-y-8"]}>
			<div class="font-heading sticky top-2 mt-2 hidden @5xl:block">
				<TableOfContent isOpened={true} headings={headings} />
			</div>
		</div>

		<div id="article-content" class="prose py-4 2xl:!col-start-3">
			<slot>nothing to see here</slot>
		</div>
	</div>

	<div class="mx-auto mt-8 max-w-2xl">
		<ArticleTags tags={post.tags} />
	</div>
</article>
