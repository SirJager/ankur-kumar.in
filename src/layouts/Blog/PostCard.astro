---
import Link from "@/components/Link.astro";
import type {Post} from "@/dal/schema";
import {parseDate} from "@/lib/utils";
import {Icon} from "astro-icon/components";
import styles from "@/styles";

interface Props {
	post: Post;
	index?: number;
	loading?: string;
}
const {post} = Astro.props;
const image = post.banner || `${Astro.url.origin}/blog/${post.slug}/og.png`;
const date = parseDate(post.publish.toISOString());
---

<div
	class:list={[
		"group relative w-full cursor-default overflow-hidden",
		// background hover overlay
		"p-4 after:rounded-btn after:p-0.5 hover:shadow-xl",
		"after:absolute after:left-0 after:top-0 after:h-full after:w-full after:content-['']",
		"after:border-2 after:border-transparent hover:after:border-base-300",
		"brightness-90 hover:brightness-110 hover:after:bg-base-200 group-hover:text-base-content",
	]}
>
	<div class="relative z-[1] w-full">
		<Link
			aria-label={`Read "${post.title}"`}
			href={`/blog/${post.slug}`}
			class="block aspect-[40/21] overflow-clip rounded-btn"
		>
			<figure transition:name="image">
				<img src={image} alt={post.title} height={170} width={328} class="w-full" />
			</figure>
		</Link>

		<Link href={`/blog/${post.slug}`} aria-label={`Read "${post.title}"`} class="mt-3 block">
			<div class="flex items-center">
				<h3 class="scramble text-lg font-semibold transition-colors duration-300 ease-in-out">
					{post.title}
				</h3>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="mb-1 inline h-5 w-5 stroke-base-content"
				>
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
					<path d="M17 7l-10 10"></path>
					<path d="M8 7l9 0l0 9"></path>
				</svg>
			</div>
		</Link>

		<p class="prose prose-sm line-clamp-3">{post.description}</p>

		<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
			<div
				class="flex items-center gap-1"
				title={`Published on ${date.date} ${date.month} ${date.year}`}
			>
				<Icon size={22} name="tabler:calendar-month" />
				<p class="prose prose-sm">{date.date} {date.month} {date.year}</p>
				{
					post.tags.length !== 0 && (
						<div class="group/tags flex flex-wrap items-center">
							<Icon
								size={22}
								name={post.tags.length < 2 ? "tabler:tag" : "tabler:tags"}
								class="mx-1"
							/>
							{post.tags.map((tag) => {
								return (
									<Link
										href={`/tags/${tag}`}
										aria-label={`View posts tagged with ${tag}`}
										class:list={[
											"prose-sm relative py-0.5 sm:prose-base",
											...styles.underlinefx.main,
											"after:bg-base-content",
										]}
									>
										<span class={styles.underlinefx.span}> #{tag}</span>
									</Link>
								);
							})}
						</div>
					)
				}
			</div>
		</div>
	</div>
</div>
