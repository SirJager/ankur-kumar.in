---
import {getEntry} from "astro:content";
import Link from "@/components/Link.astro";
import PageFind from "@/components/PageFind.astro";
import ReadMore from "@/components/ReadMore.astro";
import {links} from "@/lib/constants/links";
import styles from "@/styles";
import BlogNavigation from "./BlogNavigation.astro";

// fetch data
const blogData = await getEntry("blog", "index");
if (!blogData) {
	throw new Error("Failed to fech blog info");
}
const {blog} = blogData.data;
---

<header
	style="background: var(--grid-cell);"
	class:list={[
		"fade-top dark:fade-top-bottom relative mx-auto mt-20 max-w-4xl overflow-hidden bg-repeat px-4",
	]}>
	<div class="flex h-full w-full flex-col justify-center py-8 md:px-12">
		<h1
			aria-role="heading"
			data-weight="50"
			data-pagefind-meta="title"
			data-pagefind-sort="weight[data-weight]"
			class:list={[
				"font-title text-pretty text-3xl font-medium sm:text-5xl md:text-6xl",
			]}>
			{blog.title}
		</h1>

		<ReadMore readmore={blog.readmore} className="group mt-12"> {blog.description} </ReadMore>
		<p
			class:list={[
				"prose-sm mt-2 text-pretty font-medium",
				"sm:prose-lg prose-a:font-bold prose-a:text-accent",
			]}>
			Subscribe to the <Link
				aria-label="RSS"
				href={links.rss.href}
				class:list={styles.underlinefx.main}>
				<span class={styles.underlinefx.span}>RSS Feed</span>
			</Link> to stay updated.
		</p>
	</div>
</header>

<div class="sticky top-0 z-50 hidden sm:inline">
	<BlogNavigation />
	<PageFind />
</div>

<slot name="body"> nothing to see here </slot>
