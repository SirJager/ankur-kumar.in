---
import Link from "@/components/Link.astro";

import ReadMore from "@/components/ReadMore.astro";
import {links, site} from "@/lib/constants";
import BlogNavigation from "./BlogNavigation.astro";
---

<header
	class:list={[
		"relative mx-auto mt-32 max-w-4xl bg-repeat",
		"fade-top-bottom bg-[url('/svg/grid-cell-light.svg')] dark:bg-[url('/svg/grid-cell-dark.svg')]",
	]}
>
	<div class="flex h-full w-full flex-col justify-center py-8 md:px-12">
		<h1
			role="heading"
			data-weight="50"
			data-pagefind-meta="title"
			data-pagefind-sort="weight[data-weight]"
			class:list={["text-pretty text-6xl", "font-headline font-bold"]}
		>
			{site.blog.title}
		</h1>

		<ReadMore readmore={site.blog.readmore} className="mt-12">
			{site.blog.description}
		</ReadMore>
		<p class="prose-sm mt-2 text-pretty font-medium md:prose-lg prose-a:text-primary">
			Subscribe to the <Link aria-label="RSS" href={links.rss.href}>RSS Feed</Link> to stay updated.
		</p>
	</div>
</header>

<div class="sticky top-0 z-50">
	<BlogNavigation />
</div>

<slot name="body"> BlogLayout: use slot="body" </slot>
