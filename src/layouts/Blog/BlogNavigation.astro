---
import Link from "@/components/Link.astro";
import type {ILink} from "@/dal/types";

interface Props {
	links?: readonly ILink[];
}

const {links = []} = Astro.props;
---

<div transition:name="blognavbar" class="relative mx-auto mt-12 w-full max-w-4xl px-12 py-2">
	<div
		id="bar"
		class:list={[
			"w-full overflow-clip rounded-full p-2",
			"flex items-center justify-evenly gap-2",
			"shadow-md drop-shadow-md",
			"border border-base-300 dark:border-base-content/10",
			"bg-gradient-to-r from-base-200 via-base-300 to-base-200",
		]}
	>
		<button
			class:list={[
				"grid aspect-square place-items-center rounded-full p-2",
				"h-10 max-h-10 min-h-10",
				"w-10 min-w-10 max-w-10",
				"shadow-md drop-shadow-md",
				"bg-gradient-to-r from-base-300/30 via-base-300 to-base-300/30",
				"border-2 border-base-300 dark:border-base-300",
			]}
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				class="fill-base-content/70 brightness-50 hover:brightness-125"
			>
				<path
					fill="currentColor"
					d="M12 5C4.19 5 2 9.48 2 12c0 3.86 3.13 7 6.99 7h6.02C17.7 19 22 16.92 22 12c0 0 0-7-10-7m0 2c7.64 0 7.99 4.51 8 5H4c0-.2.09-5 8-5m2.86 10H9.14c-2.1 0-3.92-1.24-4.71-3h15.15c-.8 1.76-2.62 3-4.72 3"
				></path>
			</svg>
		</button>

		<div class="grid flex-1 grid-cols-4">
			{
				links.map((item) => (
					<Link
						href={item.href}
						aria-label={item.label}
						newtab={item.newtab}
						nofocus={true}
						class:list={[
							"scramble text-sm uppercase",
							"flex items-center justify-center",
							"tracking-wider transition-all duration-300 ease-in-out",
							"brightness-50 hover:brightness-125",
						]}
					>
						{item.label}
					</Link>
				))
			}
		</div>

		<button
			class:list={[
				"grid aspect-square place-items-center rounded-full p-2",
				"h-10 max-h-10 min-h-10",
				"w-10 min-w-10 max-w-10",
				"shadow-md drop-shadow-md",
				"bg-gradient-to-r from-base-300/30 via-base-300 to-base-300/30",
				"border-2 border-base-300 dark:border-base-300",
			]}
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="fill-base-content/70 brightness-50 hover:brightness-125"
				width="20"
				height="20"
				viewBox="0 0 24 24"
			>
				<path
					d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5A6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5S14 7.01 14 9.5S11.99 14 9.5 14"
				></path>
			</svg>
		</button>
	</div>
</div>
