---
import PostCard from "./PostCard.astro";
import type {Post} from "@keystatic/collections/posts";
interface Props {
	posts: Post[];
}

const {posts} = Astro.props;
---

<div
	class:list={[
		"relative w-full gap-6",
		"grid grid-cols-1 justify-center sm:grid-cols-2",
		//
	]}>
	{
		posts.map((post, index) => (
			<PostCard index={index} post={post} loading={index < 2 ? "eager" : undefined} />
		))
	}
</div>
