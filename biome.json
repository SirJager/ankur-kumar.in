{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "!**/node_modules",
      "!.obsidian",
      "!.astro",
      "!**/dist",
      "!**/_pagefind",
      "!**/public",
      "src"
    ]
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "organizeImports": "on",
        "useSortedAttributes": "off"
      }
    }
  },
  "formatter": {
    "lineWidth": 100,
    "indentWidth": 2,
    "indentStyle": "tab",
    "expand": "never",
    "trailingNewline": true,
    "bracketSameLine": true,
    "useEditorconfig": true,
    "bracketSpacing": false,
    "attributePosition": "auto"
  },
  "linter": {
    "rules": {
      "a11y": {"noSvgWithoutTitle": "off"},
      "style": {"useFilenamingConvention": "off"},
      "suspicious": {"noExplicitAny": "off"},
      "complexity": {"noForEach": "off"},
      "correctness": {"useQwikValidLexicalScope": "off"},
      "nursery": {"useSortedClasses": "off"}
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off",
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "useJsxKeyInIterable": "off"
          },
          "suspicious": {"noArrayIndexKey": "off"}
        }
      }
    }
  ]
}
