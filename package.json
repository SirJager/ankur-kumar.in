{
	"name": "portfolio",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"deps": "pnpm install --shamefully-hoist",
		"start": "astro preview",
		"build": "astro check && astro build && pnpm run postbuild",
		"preview": "astro preview",
		"astro": "astro",
		"changeset": "changeset",
		"changelog": "changeset version",
		"postbuild": "pnpm run pagefind",
		"clean": "rm -rf ./.astro ./dist ./.vercel ./public/_pagefind",
		"lint": "eslint . --fix",
		"pagefind": "if [ -d ./dist/client ]; then npm run pagefind:node; elif [ -d .vercel/output/static ]; then npm run pagefind:vercel; fi",
		"pagefind:node": "pagefind --site ./dist/client --output-subdir _pagefind",
		"pagefind:vercel": "pagefind --site .vercel/output/static --output-subdir _pagefind",
		"pagefind:dev": "if [ -d ./dist/client ]; then cp -rf ./dist/client/_pagefind ./public ; elif [ -d .vercel/output/static ]; then cp -rf .vercel/output/static/_pagefind ./public; fi",
		"format": "npm run format:fix && npm run format:check",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write ."
	},
	"dependencies": {
		"@astrojs/check": "0.9.4",
		"@astrojs/markdoc": "^0.12.7",
		"@astrojs/mdx": "4.0.7",
		"@astrojs/node": "9.0.2",
		"@astrojs/partytown": "2.1.3",
		"@astrojs/react": "^4.1.6",
		"@astrojs/rss": "4.0.11",
		"@astrojs/sitemap": "3.2.1",
		"@astrojs/tailwind": "5.1.5",
		"@astrojs/vercel": "8.0.4",
		"@builder.io/qwik": "^1.12.0",
		"@fontsource-variable/inter": "^5.0.18",
		"@fontsource-variable/raleway": "^5.0.20",
		"@qwikdev/astro": "^0.7.4",
		"@unpic/qwik": "^0.0.44",
		"@vercel/og": "^0.6.2",
		"astro": "5.1.9",
		"astro-auto-import": "^0.4.4",
		"astro-breadcrumbs": "^2.3.0",
		"astro-compressor": "^0.4.1",
		"astro-font": "^0.0.81",
		"astro-icon": "^1.1.0",
		"astro-imagetools": "0.9.0",
		"daisyui": "^4.7.3",
		"gray-matter": "^4.0.3",
