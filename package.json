{
	"name": "portfolio",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"deps": "pnpm install --shamefully-hoist",
		"start": "astro preview",
		"build": "astro check && astro build && pnpm run postbuild",
		"preview": "astro preview",
		"astro": "astro",
		"changeset": "changeset",
		"changelog": "changeset version",
		"postbuild": "pnpm run pagefind",
		"clean": "rm -rf ./.astro ./dist ./.vercel ./public/_pagefind",
		"lint": "eslint . --fix",
		"pagefind": "if [ -d ./dist/client ]; then npm run pagefind:node; elif [ -d .vercel/output/static ]; then npm run pagefind:vercel; fi",
		"pagefind:node": "pagefind --site ./dist/client --output-subdir _pagefind",
		"pagefind:vercel": "pagefind --site .vercel/output/static --output-subdir _pagefind",
		"pagefind:dev": "if [ -d ./dist/client ]; then cp -rf ./dist/client/_pagefind ./public ; elif [ -d .vercel/output/static ]; then cp -rf .vercel/output/static/_pagefind ./public; fi",
		"format": "npm run format:fix && npm run format:check",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write ."
	},
	"dependencies": {
		"@astrojs/check": "0.9.6",
		"@astrojs/markdoc": "^0.15.10",
		"@astrojs/mdx": "4.3.13",
		"@astrojs/node": "9.5.4",
		"@astrojs/partytown": "2.1.4",
		"@astrojs/react": "^4.4.2",
		"@astrojs/rss": "4.0.15",
		"@astrojs/sitemap": "3.7.0",
		"@astrojs/vercel": "9.0.4",
		"@builder.io/qwik": "^1.19.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/raleway": "^5.2.8",
		"@qwikdev/astro": "^0.7.12",
		"@tailwindcss/postcss": "^4.2.1",
		"@tailwindcss/vite": "^4.2.1",
		"@unpic/qwik": "^0.0.44",
		"@vercel/og": "^0.8.6",
		"astro": "5.17.3",
		"astro-auto-import": "^0.4.6",
		"astro-breadcrumbs": "^2.3.1",
		"astro-compressor": "^0.4.1",
		"astro-font": "^0.0.81",
		"astro-icon": "^1.1.5",
		"astro-imagetools": "0.9.0",
		"gray-matter": "^4.0.3",
